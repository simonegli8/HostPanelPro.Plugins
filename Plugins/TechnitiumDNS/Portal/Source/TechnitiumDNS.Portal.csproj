<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <RootNamespace>HostPanelPro.Plugins.TechnitiumDNS</RootNamespace>
        <AssemblyName>HostPanelPro.Plugins.TechnitiumDNS</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <RestoreSources>..\..\..\..\HostPanelPro\Lib;$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HostPanelPro.Providers.Base" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.WebPortal" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Portal.Modules" Version="1.0.0" />
        <ProjectReference Include="..\..\Common\Source\TechnitiumDNS.Common.csproj" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net48'">
        <Reference Include="System.Web" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="WebFormsForCore.Web" Version="1.6.0" />
        <PackageReference Include="WebFormsForCore.Build" Version="1.6.0" />
        <PackageReference Include="System.Web.Services.Description" Version="10.0.0" Aliases="SD" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Configuration\" />
        <Folder Include="Pages\" />
    </ItemGroup>

</Project>
