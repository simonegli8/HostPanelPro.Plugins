<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net48;net10.0</TargetFrameworks>
        <RootNamespace>HostPanelPro.Plugins.TechnitiumDNS</RootNamespace>
        <AssemblyName>HostPanelPro.Plugins.TechnitiumDNS.Portal</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <RestoreSources>..\..\..\..\Library;$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>
        <OutputPath>..\bin</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <Compile Remove="Configuration\**" />
      <EmbeddedResource Remove="Configuration\**" />
      <None Remove="Configuration\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Pages\ProviderControls\TechnitiumDNS_Settings.ascx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="HostPanelPro.EnterpriseServer.Client" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Web.Clients" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Plugins" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Portal.Modules" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net48'">
        <Reference Include="System.Web" />
    </ItemGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="WebFormsForCore.Web" Version="1.6.8" />
        <PackageReference Include="WebFormsForCore.Build" Version="1.6.8" />
        <PackageReference Include="WebFormsForCore.Web.Services" Version="1.6.8" />
        <PackageReference Include="System.Web.Services.Description" Version="10.0.0" Aliases="SD" />
    </ItemGroup>

    <Target Name="CleanOutput" AfterTargets="Build">
        <ItemGroup>
            <FilesToDelete Include="$(OutputPath)\**\*.*" Exclude="$(OutputPath)\**\HostPanelPro.Plugins.TechnitiumDNS.*;$(OutputPath)\**\*.ascx" />
            <FilesInDirs Include="$(OutputPath)**\runtimes\**\*.*" />
            <FilesInDirs Include="$(OutputPath)**\??\*.resources.dll" />
            <FilesInDirs Include="$(OutputPath)**\??-??\*.resources.dll" />
            <FilesInDirs Include="$(OutputPath)**\zh-*\*.*" />
            <FilesInDirs Include="$(OutputPath)**\x64\*.*" />
            <FilesInDirs Include="$(OutputPath)**\x86\*.*;" />
            <DirectoriesToDelete Include="@(FilesInDirs->'%(RootDir)%(Directory)')" />
        </ItemGroup>
        <Delete Files="@(FilesToDelete)" />
        <RemoveDir Directories="@(DirectoriesToDelete)" />
        <RemoveDir Directories="$(OutputPath)\runtimes" />
    </Target>

</Project>
