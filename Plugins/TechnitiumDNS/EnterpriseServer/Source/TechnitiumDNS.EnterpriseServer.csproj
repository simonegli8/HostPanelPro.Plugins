<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net48</TargetFrameworks>
        <RootNamespace>HostPanelPro.Plugins.TechnitiumDNS</RootNamespace>
        <AssemblyName>HostPanelPro.Plugins.TechnitiumDNS.EnterpriseServer</AssemblyName>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <RestoreSources>..\..\..\..\..\HostPanelPro\Lib;$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>
        <OutputPath>..\bin</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HostPanelPro.Build" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Plugins" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Web.Services" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.EnterpriseServer.Code" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.EnterpriseServer.Data" Version="1.0.0" />
    </ItemGroup>

    <Target Name="CleanOutput" AfterTargets="Build">
        <ItemGroup>
            <FilesToDelete Include="$(OutputPath)\**\*.*" Exclude="$(OutputPath)\**\HostPanelPro.Plugins.TechnitiumDNS.*" />
            <FilesInDirs Include="$(OutputPath)**\runtimes\**\*.*;
                $(OutputPath)**\??\*.resources.dll;
                $(OutputPath)**\??-??\*.resources.dll;
                $(OutputPath)**\zh-*\*.*;
                $(OutputPath)**\x64\*.*;
                $(OutputPath)**\x86\*.*;" />
            <DirectoriesToDelete Include="@(FilesInDirs->'%(RootDir)%(Directory)')" />
        </ItemGroup>
        <Delete Files="@(FilesToDelete)" />
        <RemoveDir Directories="@(DirectoriesToDelete)" />
        <RemoveDir Directories="$(OutputPath)\runtimes" />
    </Target>
    
</Project>
