        <PackageReference Include="HostPanelPro.EnterpriseServer.Code" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.EnterpriseServer.Data" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Web.Services" Version="1.0.0" />
        <PackageReference Include="HostPanelPro.Web.Clients" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Common\Source\PluginName1.Common.csproj" />
    </ItemGroup>

</Project>
